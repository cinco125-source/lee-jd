  .lee-sec-2 { background: radial-gradient(circle at 75% 50%, #22324a 0%, #101b29 65%); }
  .lee-sec-3 { background: radial-gradient(circle at 75% 50%, #1d3550 0%, #0e1824 65%); }
  #lee-main { scroll-snap-align: start; }
  .lee-sec-inner { width: 100%; max-width: 1320px; margin: 0 auto; padding: 3rem 4.5rem 3.5rem 2rem; display: grid; grid-template-columns: minmax(300px, 0.9fr) 1.35fr; gap: 3rem; align-items: center; }
