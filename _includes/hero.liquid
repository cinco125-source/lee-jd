<section class="lee-hero" aria-label="Introduction">
  <!-- 01 flight experiments (video) -->
  <div class="lee-slide is-active" data-slide="0">
    <video class="lee-hero-video" src="/assets/video/hero_flight.mp4" poster="/assets/img/hero/hero_poster.jpg" muted playsinline preload="auto" aria-hidden="true"></video>
  </div>
  <!-- 02 conference presentations (photo grid) -->
  <div class="lee-slide lee-slide-conf" data-slide="1">
    <div class="lee-conf-grid">
      <figure><img src="/assets/img/hero/conf1.jpg" alt="ION Pacific PNT 2026, Honolulu" loading="lazy"><figcaption>ION Pacific PNT 2026 · Honolulu</figcaption></figure>
      <figure><img src="/assets/img/hero/conf2.jpg" alt="IFAC World Congress 2026, Busan" loading="lazy"><figcaption>IFAC World Congress 2026 · Busan</figcaption></figure>
      <figure><img src="/assets/img/hero/conf3.jpg" alt="ICROS 2026 poster" loading="lazy"><figcaption>ICROS 2026</figcaption></figure>
    </div>
  </div>
  <!-- 03 team -->
  <div class="lee-slide" data-slide="2">
    <div class="lee-sub is-on" style="background-image: url('/assets/img/hero/defense.jpg'); background-position: 58% 35%;"></div>
    <div class="lee-sub" style="background-image: url('/assets/img/hero/team.jpg'); background-position: 62% 60%;"></div>
  </div>

  <div class="lee-hero-shade"></div>
  <div class="lee-hero-inner">
    <div class="lee-hero-kicker">Welcome! I'm</div>
    <h1 class="lee-hero-name">JAYDEN<br>DONGWOO LEE</h1>
    <p class="lee-hero-tag">Guidance, navigation, and control for aerial vehicles that stay safe when models fail, components break, or GNSS disappears.</p>
    <p class="lee-hero-sub">From algorithms to flight hardware.</p>
    <div class="lee-hero-cta">
      <a class="lee-btn lee-btn-solid lee-enter" href="#lee-main">Enter Site &#8595;</a>
      <a class="lee-btn" href="/research/">Research</a>
      <a class="lee-btn" href="/publications/">Publications</a>
      <a class="lee-btn" href="/assets/pdf/Jayden_Dongwoo_Lee_CV.pdf" download="Jayden_Dongwoo_Lee_CV.pdf">Download CV</a>
    </div>
  </div>

  <div class="lee-hero-nav">
    <button class="lee-dot is-active" data-go="0" aria-label="Slide 1: flight experiments">01</button>
    <button class="lee-dot" data-go="1" aria-label="Slide 2: conference presentations">02</button>
    <button class="lee-dot" data-go="2" aria-label="Slide 3: research team">03</button>
  </div>
  <div class="lee-hero-caption"><span class="lee-hero-count">01 / 03</span> <span class="lee-hero-label">Flight experiments</span></div>
  <a class="lee-hero-down" href="#lee-main" aria-label="Scroll to content">&#8595;</a>
</section>
<div id="lee-main"></div>

<style>
  html, body { overflow-x: hidden; }
  .lee-hero { position: relative; width: 100vw; left: 50%; margin-left: -50vw; height: calc(100vh - 59px - 35px); min-height: 540px; margin-top: -32px; margin-bottom: 2.5rem; overflow: hidden; background: #0e1824; color: #fff; }
  .lee-slide { position: absolute; inset: 0; opacity: 0; transition: opacity 1.2s ease; }
  .lee-slide.is-active { opacity: 1; }
  .lee-sub { position: absolute; inset: 0; background-size: cover; opacity: 0; transition: opacity 1.2s ease; }
  .lee-sub.is-on { opacity: 1; }
  .lee-hero-video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 60% 40%; }
  .lee-slide-conf { background: radial-gradient(circle at 75% 40%, #1d3550 0%, #0e1824 70%); }
  .lee-conf-grid { position: absolute; right: 4.5vw; top: 50%; transform: translateY(-50%); width: min(44vw, 720px, calc((100vh - 230px) * 1.25)); display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  .lee-conf-grid figure:first-child { grid-column: 1 / 3; aspect-ratio: 16 / 8; }
  .lee-conf-grid figure { margin: 0; position: relative; aspect-ratio: 4 / 3; overflow: hidden; border-radius: 6px; box-shadow: 0 10px 30px rgba(0,0,0,0.45); }
  .lee-conf-grid img { width: 100%; height: 100%; object-fit: cover; transform: scale(1.04); transition: transform 6s ease; }
  .lee-slide-conf.is-active .lee-conf-grid img { transform: scale(1); }
  .lee-conf-grid figcaption { position: absolute; left: 0; right: 0; bottom: 0; padding: 0.5rem 0.7rem; font-family: "Inter", sans-serif; font-size: 0.72rem; letter-spacing: 0.06em; text-transform: uppercase; background: linear-gradient(0deg, rgba(14,24,36,0.85), rgba(14,24,36,0)); }
  .lee-hero-shade { position: absolute; inset: 0; pointer-events: none; background: linear-gradient(90deg, rgba(14,24,36,0.92) 0%, rgba(14,24,36,0.7) 38%, rgba(14,24,36,0.1) 72%), linear-gradient(0deg, rgba(14,24,36,0.6) 0%, rgba(14,24,36,0) 35%); }
  .lee-hero-inner { position: relative; z-index: 2; max-width: 1100px; height: 100%; margin: 0 auto; padding: 0 1.5rem; display: flex; flex-direction: column; justify-content: center; pointer-events: none; }
  .lee-hero-inner a { pointer-events: auto; }
  .lee-hero-kicker { font-family: "Inter", sans-serif; font-size: 0.8rem; letter-spacing: 0.25em; text-transform: uppercase; color: #d2b48c; margin-bottom: 0.6rem; }
  .lee-hero-name { font-family: "Inter", sans-serif !important; font-weight: 800 !important; font-size: clamp(2.6rem, 6.4vw, 5.4rem); line-height: 0.98; letter-spacing: -0.02em; color: #fff; margin: 0 0 1.2rem; }
  .lee-hero-tag { font-size: clamp(1rem, 1.5vw, 1.2rem); max-width: 32rem; line-height: 1.5; color: rgba(255,255,255,0.92); margin: 0 0 0.3rem; }
  .lee-hero-sub { font-size: 0.95rem; color: rgba(255,255,255,0.65); margin: 0 0 1.8rem; }
  .lee-hero-cta { display: flex; flex-wrap: wrap; gap: 0.7rem; }
  .lee-btn { display: inline-block; padding: 0.7rem 1.15rem; border: 1px solid rgba(255,255,255,0.55); color: #fff !important; font-family: "Inter", sans-serif; font-size: 0.8rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; text-decoration: none !important; transition: background .2s, border-color .2s; }
  .lee-btn:hover { background: rgba(255,255,255,0.12); border-color: #fff; }
  .lee-btn-solid { background: #fff; color: #0e1824 !important; border-color: #fff; }
  .lee-btn-solid:hover { background: #d2b48c; border-color: #d2b48c; }
  .lee-hero.is-last .lee-enter { animation: leepulse 1.6s ease-in-out infinite; }
  @keyframes leepulse { 0%,100% { box-shadow: 0 0 0 0 rgba(210,180,140,0); } 50% { box-shadow: 0 0 0 8px rgba(210,180,140,0.35); } }
  .lee-hero-nav { position: absolute; z-index: 3; right: 1.5rem; top: 50%; transform: translateY(-50%); display: flex; flex-direction: column; gap: 0.6rem; }
  .lee-dot { background: none; border: 0; border-right: 2px solid transparent; color: rgba(255,255,255,0.45); font-family: "Inter", sans-serif; font-size: 0.75rem; font-weight: 600; letter-spacing: 0.1em; cursor: pointer; padding: 0.2rem 0.5rem 0.2rem 0; }
  .lee-dot.is-active { color: #d2b48c; border-right-color: #d2b48c; }
  .lee-hero-caption { position: absolute; z-index: 3; bottom: 1.6rem; left: 1.5rem; font-family: "Inter", sans-serif; font-size: 0.75rem; letter-spacing: 0.12em; color: rgba(255,255,255,0.75); text-transform: uppercase; }
  .lee-hero-count { color: #d2b48c; font-weight: 600; margin-right: 0.6rem; }
  .lee-hero-down { position: absolute; z-index: 3; bottom: 1.3rem; left: 50%; transform: translateX(-50%); width: 38px; height: 38px; border: 1px solid rgba(255,255,255,0.5); border-radius: 50%; color: #fff !important; text-align: center; line-height: 36px; text-decoration: none !important; animation: leebob 2s ease-in-out infinite; }
  @keyframes leebob { 0%,100% { transform: translate(-50%, 0); } 50% { transform: translate(-50%, 6px); } }
  @media (max-width: 1100px) { .lee-hero-name { font-size: clamp(2.4rem, 5.2vw, 4rem); } .lee-hero-tag { max-width: 26rem; } }
  @media (max-width: 760px) { .lee-hero-shade { background: rgba(14,24,36,0.72); } .lee-hero-caption, .lee-conf-grid { display: none; } .lee-hero-nav { right: 0.6rem; } }
  @media (prefers-reduced-motion: reduce) { .lee-slide, .lee-conf-grid img { transition: none; } .lee-hero-down, .lee-enter { animation: none !important; } }
</style>

<script>
  (function () {
    var hero = document.querySelector(".lee-hero");
    if (!hero) return;
    var slides = hero.querySelectorAll(".lee-slide");
    var dots = hero.querySelectorAll(".lee-dot");
    var count = hero.querySelector(".lee-hero-count");
    var label = hero.querySelector(".lee-hero-label");
    var video = hero.querySelector(".lee-hero-video");
    var titles = ["Flight experiments", "Conference presentations", "Ph.D. defense, KAIST"];
    var subs = hero.querySelectorAll(".lee-sub"), subTitles = ["Ph.D. defense, KAIST", "Research team, KAIST"], subTimer = null, subIdx = 0;
    var clipCuts = [4.6, 12.8, 21.0];
    var clipLabels = ["Flight experiments · hoverbike flight test", "Flight experiments · eVTOL actuator fault detection", "Flight experiments · magnetic-anomaly navigation", "Flight experiments · eVTOL fault-tolerant control"];
    var reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    var cur = 0, timer = null;

    function show(k) {
      cur = k;
      slides.forEach(function (s, i) { s.classList.toggle("is-active", i === k); });
      dots.forEach(function (d, i) { d.classList.toggle("is-active", i === k); });
      count.textContent = "0" + (k + 1) + " / 03";
      label.textContent = titles[k];
      hero.classList.toggle("is-last", k === 2);
      clearTimeout(timer); clearInterval(subTimer);
      if (k === 2) {
        subIdx = 0; subs.forEach(function (x, i) { x.classList.toggle("is-on", i === 0); });
        if (!reduce) subTimer = setInterval(function () {
          subIdx = (subIdx + 1) % subs.length;
          subs.forEach(function (x, i) { x.classList.toggle("is-on", i === subIdx); });
          label.textContent = subTitles[subIdx];
        }, 5000);
      }
      if (k === 0) {
        video.currentTime = 0;
        if (!reduce) { var p = video.play(); if (p && p.catch) p.catch(function () {}); }
      } else {
        video.pause();
        if (k === 1 && !reduce) timer = setTimeout(function () { show(2); }, 7000);
      }
    }

    video.addEventListener("timeupdate", function () {
      if (cur !== 0) return;
      var t = video.currentTime;
      var k = 0; while (k < clipCuts.length && t >= clipCuts[k]) k++; label.textContent = clipLabels[k];
    });
    video.addEventListener("ended", function () { if (cur === 0) show(1); });
    dots.forEach(function (d) { d.addEventListener("click", function () { show(+d.dataset.go); }); });
    show(0);
  })();
</script>
