  .lee-swap img.wide { top: 50%; height: auto; width: 68%; transform: translateY(-50%) scale(1.03); -webkit-mask-image: linear-gradient(90deg, transparent 0%, #000 22%); mask-image: linear-gradient(90deg, transparent 0%, #000 22%); }
  .lee-swap img.wide.is-on { transform: translateY(-50%) scale(1); }
