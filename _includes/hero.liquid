  @media (prefers-reduced-motion: reduce) { .lee-enter, .lee-next, .lee-dot-live { animation: none; } .lee-swap img { transition: none; } }
</style>

<script>
  (function () {
    var video = document.querySelector(".lee-video");
    var clipLabel = document.querySelector(".lee-clip-label");
    var reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (video) {
      if (reduce) { video.removeAttribute("autoplay"); video.pause(); }
      var cuts = [4.6, 10.8, 19.0, 27.2];
      var labels = ["Hoverbike flight test", "VTOL fixed-wing field flight", "eVTOL actuator fault detection", "Magnetic-anomaly navigation flight", "eVTOL fault-tolerant control after motor failure"];
      var last = -1;
      video.addEventListener("timeupdate", function () {
        var t = video.currentTime, k = 0;
        while (k < cuts.length && t >= cuts[k]) k++;
        if (k !== last) { last = k; clipLabel.textContent = labels[k]; }
      });
    }
    // slide 3: alternate defense / team photos
    var imgs = document.querySelectorAll(".lee-swap img");
    var swapLabel = document.querySelector(".lee-swap-label");
    var names = ["Ph.D. defense, KAIST", "Research team, KAIST"], j = 0;
    if (imgs.length > 1 && !reduce) setInterval(function () {
      imgs[j].classList.remove("is-on"); j = (j + 1) % imgs.length; imgs[j].classList.add("is-on");
      setTimeout(function () { swapLabel.textContent = names[j]; }, 500);
    }, 5000);
    // right rail: highlight current section, hide after the cover
    var rail = document.querySelector(".lee-rail"), links = rail.querySelectorAll("a");
    var secs = document.querySelectorAll(".lee-sec"), main = document.getElementById("lee-main");
    function onScroll() {
      var mid = window.innerHeight * 0.45, k = 0;
      secs.forEach(function (s, i) { if (s.getBoundingClientRect().top <= mid) k = i; });
      links.forEach(function (a, i) { a.classList.toggle("is-active", i === k); });
      rail.classList.toggle("is-hidden", main.getBoundingClientRect().top < mid);
    }
    window.addEventListener("scroll", onScroll, { passive: true });
    onScroll();
  })();
</script>
