  .lee-btn { display: inline-block; padding: 0.68rem 1.1rem; border: 1px solid rgba(255,255,255,0.55); color: #fff !important; font-family: "Inter", sans-serif; font-size: 0.78rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; text-decoration: none !important; transition: background .2s, border-color .2s; }
  .lee-btn:hover { background: rgba(255,255,255,0.12); border-color: #fff; }
  .lee-btn-solid { background: #fff; color: #0e1824 !important; border-color: #fff; }
  .lee-btn-solid:hover { background: #d2b48c; border-color: #d2b48c; }
  .lee-enter { animation: leepulse 1.8s ease-in-out infinite; }
  @keyframes leepulse { 0%,100% { box-shadow: 0 0 0 0 rgba(210,180,140,0); } 50% { box-shadow: 0 0 0 9px rgba(210,180,140,0.32); } }
