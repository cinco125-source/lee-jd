  .lee-live { width: 7px; height: 7px; border-radius: 50%; background: #e0574a; animation: leelive 1.6s infinite; }
  @keyframes leelive { 0% { box-shadow: 0 0 0 0 rgba(224,87,74,0.6); } 100% { box-shadow: 0 0 0 8px rgba(224,87,74,0); } }
  .lee-next { position: absolute; z-index: 3; bottom: 1.1rem; left: 50%; transform: translateX(-50%); width: 38px; height: 38px; border: 1px solid rgba(255,255,255,0.5); border-radius: 50%; color: #fff !important; text-align: center; line-height: 36px; text-decoration: none !important; animation: leebob 2s ease-in-out infinite; }
  @keyframes leebob { 0%,100% { transform: translate(-50%, 0); } 50% { transform: translate(-50%, 6px); } }
  .lee-rail { position: fixed; right: 1.2rem; top: 50%; transform: translateY(-50%); z-index: 20; display: flex; flex-direction: column; gap: 0.55rem; transition: opacity .3s; }
  .lee-rail a { font-family: "Inter", sans-serif; font-size: 0.72rem; font-weight: 700; letter-spacing: 0.1em; color: rgba(255,255,255,0.5) !important; text-decoration: none !important; padding: 0.15rem 0.5rem 0.15rem 0; border-right: 2px solid transparent; }
  .lee-rail a.is-active { color: #d2b48c !important; border-right-color: #d2b48c; }
  .lee-rail.is-hidden { opacity: 0; pointer-events: none; }
  /* phones / narrow screens: media on top at its own aspect ratio, text below */
  @media (max-width: 900px), (max-aspect-ratio: 1/1) {
    html { scroll-snap-type: none; }
    .lee-sec { height: auto; min-height: 0; display: flex; flex-direction: column; padding-bottom: 3.2rem; }
    .lee-bg-video { position: relative; inset: auto; width: 100%; height: auto; aspect-ratio: 16 / 9; object-fit: cover; object-position: right center; flex: none; }
    .lee-swap { position: relative; width: 100%; aspect-ratio: 4 / 3; flex: none; overflow: hidden; }
    .lee-swap img, .lee-swap img.wide, .lee-flip .lee-swap img { top: 0; left: 0; right: auto; width: 100%; height: 100%; object-fit: cover; object-position: center 30%; transform: none !important; -webkit-mask-image: none !important; mask-image: none !important; }
    .lee-shade { display: none; }
    .lee-inner, .lee-flip .lee-inner { height: auto; padding: 1.6rem 1.4rem 0 !important; align-items: flex-start !important; text-align: left !important; }
    .lee-flip .lee-cta { justify-content: flex-start !important; }
    .lee-name { font-size: clamp(2.2rem, 10vw, 3.2rem); }
    .lee-h2 { font-size: clamp(1.9rem, 8.5vw, 2.6rem); }
    .lee-rail, .lee-cap { display: none; }
    .lee-next { bottom: 0.7rem; }
  }
  @media (prefers-reduced-motion: reduce) { .lee-enter, .lee-next, .lee-live { animation: none; } .lee-swap img { transition: none; transform: none; } }
  /* mirrored slide: photo left, text right */
  .lee-flip .lee-swap img { right: auto; left: 0; transform-origin: left center; -webkit-mask-image: linear-gradient(270deg, transparent 0%, #000 28%) !important; mask-image: linear-gradient(270deg, transparent 0%, #000 28%) !important; }
  .lee-flip .lee-shade { background: linear-gradient(270deg, rgba(14,24,36,0.96) 0%, rgba(14,24,36,0.82) 30%, rgba(14,24,36,0.25) 58%, rgba(14,24,36,0.05) 80%), linear-gradient(0deg, rgba(14,24,36,0.55) 0%, rgba(14,24,36,0) 30%); }
  .lee-flip .lee-inner { align-items: flex-end; text-align: right; padding: 0 clamp(4rem, 7vw, 7rem) 0 2rem; }
  .lee-flip .lee-cta { justify-content: flex-end; }
  .lee-flip .lee-kicker span { margin-right: 0.8rem; }
  .lee-flip .lee-cap { left: auto; right: clamp(4rem, 7vw, 7rem); }
</style>

<script>
  (function () {
    var reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    // slide 1: video captions in sync with clips
    var video = document.querySelector(".lee-bg-video"), vLabel = document.querySelector("[data-video-label]");
    if (video) {
      if (reduce) { video.removeAttribute("autoplay"); video.pause(); }
      var cuts = [4.6, 10.8, 19.0, 27.2];
      var labels = ["Hoverbike flight test", "VTOL fixed-wing field flight", "eVTOL actuator fault detection", "Magnetic-anomaly navigation flight", "eVTOL fault-tolerant control after motor failure"];
      var last = -1;
      video.addEventListener("timeupdate", function () {
        var t = video.currentTime, k = 0;
        while (k < cuts.length && t >= cuts[k]) k++;
        if (k !== last) { last = k; vLabel.textContent = labels[k]; }
      });
    }
    // slides 2-3: one photo at a time, cross-fading
    document.querySelectorAll(".lee-sec").forEach(function (sec) {
      var box = sec.querySelector(".lee-swap"); if (!box) return;
      var imgs = box.querySelectorAll("img"), label = sec.querySelector("[data-swap-label]"), i = 0;
      if (imgs.length < 2 || reduce) return;
      setInterval(function () {
        imgs[i].classList.remove("is-on"); i = (i + 1) % imgs.length; imgs[i].classList.add("is-on");
        setTimeout(function () { label.textContent = imgs[i].dataset.cap; }, 500);
      }, +box.dataset.interval || 5000);
    });
    // right rail
    var rail = document.querySelector(".lee-rail"), links = rail.querySelectorAll("a");
    var secs = document.querySelectorAll(".lee-sec"), main = document.getElementById("lee-main");
    function onScroll() {
      var mid = window.innerHeight * 0.45, k = 0;
      secs.forEach(function (s, n) { if (s.getBoundingClientRect().top <= mid) k = n; });
      links.forEach(function (a, n) { a.classList.toggle("is-active", n === k); });
      rail.classList.toggle("is-hidden", main.getBoundingClientRect().top < mid);
    }
    window.addEventListener("scroll", onScroll, { passive: true });
    onScroll();
  })();
</script>
