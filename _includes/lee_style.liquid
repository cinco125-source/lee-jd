<style>
  /* publication cards */
  .publications ol.bibliography li { padding: 1.1rem 0; border-bottom: 1px solid var(--global-divider-color); }
  .publications ol.bibliography li:last-child { border-bottom: none; }
  .publications .preview { width: 100%; max-height: 230px; object-fit: contain; background: #fff; padding: 4px; margin-top: 0.4rem; }
  .publications .title { font-weight: 600; line-height: 1.35; }
  .pub-status { display: inline-block; font-size: 0.72rem; font-weight: 600; letter-spacing: 0.02em; color: #9a6b2f; border: 1px solid #d2b48c; border-radius: 4px; padding: 0 6px; margin-top: 0.25rem; }
  .pub-keywords { margin-top: 0.4rem; display: flex; flex-wrap: wrap; gap: 4px; }
  .pub-kw { font-size: 0.72rem; padding: 1px 8px; border-radius: 999px; border: 1px solid var(--global-divider-color); color: var(--global-text-color-light); }
  .pub-kw-axis { border-color: #1C2E41; color: #1C2E41; font-weight: 600; }
  html[data-theme="dark"] .pub-kw-axis, html[data-theme="dark"] .hl-card .hl-tag { border-color: #9fb3c8; color: #9fb3c8; }

  /* research highlight grid */
  .hl-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 1.2rem; margin: 1rem 0 2rem; }
  .hl-card { border: 1px solid var(--global-divider-color); border-radius: 8px; overflow: hidden; background: var(--global-bg-color); }
  .hl-card .hl-media { position: relative; aspect-ratio: 16 / 9; background: #000; }
  .hl-card .hl-media iframe, .hl-card .hl-media img { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; object-fit: cover; }
  .hl-card .hl-media img.fig { object-fit: contain; background: #fff; }
  .hl-card .hl-media a { position: absolute; inset: 0; display: block; }
  .hl-play { position: absolute; left: 50%; top: 50%; width: 54px; height: 38px; margin: -19px 0 0 -27px; border-radius: 10px; background: rgba(200, 0, 0, 0.9); transition: transform .15s; }
  .hl-play::after { content: ""; position: absolute; left: 22px; top: 11px; border-style: solid; border-width: 8px 0 8px 14px; border-color: transparent transparent transparent #fff; }
  .hl-card .hl-media a:hover .hl-play { transform: scale(1.1); }
  .hl-card .hl-body { padding: 0.7rem 0.9rem 0.9rem; }
  .hl-card .hl-tag { font-size: 0.72rem; font-weight: 600; color: #4F5D75; text-transform: uppercase; letter-spacing: 0.04em; }
  .hl-card .hl-title { font-weight: 600; margin: 0.15rem 0 0.25rem; line-height: 1.3; }
  .hl-card .hl-desc { font-size: 0.86rem; color: var(--global-text-color-light); margin: 0; }

  /* research themes */
  .theme-block { display: grid; grid-template-columns: 300px 1fr; gap: 1.4rem; align-items: start; margin: 1.6rem 0; }
  .theme-block img { width: 100%; border-radius: 6px; background: #fff; border: 1px solid var(--global-divider-color); }
  .theme-block h3 { margin-top: 0; }
  .theme-papers { font-size: 0.85rem; color: var(--global-text-color-light); margin-top: 0.4rem; }
  @media (max-width: 640px) { .theme-block { grid-template-columns: 1fr; } }
  /* photo rows */
  .photo-row { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1rem; margin: 0.8rem 0 1.6rem; }
  .photo-row figure { margin: 0; }
  .photo-row img { width: 100%; border-radius: 6px; border: 1px solid var(--global-divider-color); }
  .photo-row figcaption { font-size: 0.8rem; color: var(--global-text-color-light); margin-top: 0.3rem; }
  /* numbering on the publications page (newest = highest number) */
  .pub-numbered .num-list li { counter-increment: pubnum -1; }
  .pub-numbered .num-list .title::before { color: var(--global-text-color-light); font-weight: 600; margin-right: 0.35rem; }
  .pub-numbered .num-list[data-prefix="J"] .title::before { content: "[J" counter(pubnum) "]"; }
  .pub-numbered .num-list[data-prefix="DJ"] .title::before { content: "[DJ" counter(pubnum) "]"; }
  .pub-numbered .num-list[data-prefix="C"] .title::before { content: "[C" counter(pubnum) "]"; }
  .pub-numbered .num-list[data-prefix="DC"] .title::before { content: "[DC" counter(pubnum) "]"; }
  .theme-block { grid-template-columns: 340px 1fr; }
  .pub-jump { display: flex; flex-wrap: wrap; gap: 0.6rem; margin: 0.4rem 0 1rem; }
  .pub-jump a { padding: 0.4rem 0.9rem; border: 1px solid var(--global-divider-color); border-radius: 999px; font-weight: 600; font-size: 0.9rem; color: var(--global-text-color); text-decoration: none; }
  .pub-jump a:hover { border-color: #1C2E41; }
  .pub-jump a span { color: var(--global-text-color-light); font-weight: 500; margin-left: 0.25rem; }
  .bibliography-section-title { scroll-margin-top: 70px; }
  .theme-papers ul { margin: 0.2rem 0 0 1.1rem; padding: 0; }
  .theme-papers li { margin: 0.1rem 0; line-height: 1.45; }
  .publications [id] { scroll-margin-top: 70px; }
  .publications div[id]:target { background: rgba(210, 180, 140, 0.18); border-radius: 6px; }
</style>
