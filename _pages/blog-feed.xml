---
layout: null
permalink: /blog/feed.xml
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="en">
  <title>Jayden Dongwoo Lee: Blog</title>
  <id>{{ '/blog/' | absolute_url | xml_escape }}</id>
  <link href="{{ '/blog/feed.xml' | absolute_url | xml_escape }}" rel="self" type="application/atom+xml"/>
  <link href="{{ '/blog/' | absolute_url | xml_escape }}" rel="alternate"/>
  <updated>{{ site.time | date_to_xmlschema }}</updated>
  <author><name>Jayden Dongwoo Lee</name><uri>{{ '/' | absolute_url | xml_escape }}</uri></author>
  {% assign blog_posts = site.posts | where_exp: 'post', 'post.blog_group != nil' %}
  {% for post in blog_posts limit: 20 %}
  <entry>
    <title>{{ post.title | xml_escape }}</title>
    <id>{{ post.url | absolute_url | xml_escape }}</id>
    <link href="{{ post.url | absolute_url | xml_escape }}"/>
    <published>{{ post.date | date_to_xmlschema }}</published>
    <updated>{{ post.last_modified_at | default: post.date | date_to_xmlschema }}</updated>
    <summary>{{ post.description | default: post.excerpt | strip_html | xml_escape }}</summary>
  </entry>
  {% endfor %}
</feed>
