<!doctype html>
<html lang="{{ page.lang | default: site.lang }}">
  <head>
    {% include head.liquid %}
    <link rel="stylesheet" href="{{ '/assets/css/research-blog.css' | relative_url | bust_file_cache }}">
  </head>
  <body class="fixed-top-nav blog-site">
    <a class="blog-skip" href="#blog-content">Skip to content</a>
    {% include header.liquid %}
    {% if page.layout == 'blog-index' %}
      {% assign selected_group = site.data.blog_groups | where: 'id', page.blog_group | first %}
      <div class="blog-shell blog-index-heading mt-5">
        <header class="post-header">
          <h1 class="post-title">{{ selected_group.title | default: 'Blog' }}</h1>
          <p class="post-description">{{ selected_group.description | default: 'Paper reviews, technology, and notes along the way.' }}</p>
        </header>
      </div>
    {% endif %}
    <div class="blog-shell{% if page.layout == 'blog-index' %} blog-index-shell{% endif %}">
      {% include blog-sidebar.liquid %}
      <main id="blog-content" tabindex="-1" class="blog-main">
        {{ content }}
      </main>
    </div>
    {% include footer.liquid %}
    {% include scripts.liquid %}
    {% if page.layout == 'blog-post' %}<script src="{{ '/assets/js/blog-language.js' | relative_url | bust_file_cache }}" defer></script>{% endif %}
  </body>
</html>
